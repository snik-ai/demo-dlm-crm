# DLM Digital — Sales Infrastructure
# Copy to .env and fill in the values before deploying via Coolify.
# All services run on demo.dlm-digital.ch

# ── Resend (outbound email) ────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=Marc Schmid <marc@dlm-digital.ch>
REPLY_TO_EMAIL=sales@dlm-digital.ch

# ── Inbound IMAP (sales@dlm-digital.ch) ──────────────────────────────────────
IMAP_HOST=mail.infomaniak.com
IMAP_PORT=993
IMAP_USER=sales@dlm-digital.ch
IMAP_PASS=

# How often to poll inbox (minutes)
POLL_INTERVAL_MIN=5

# ── Security ───────────────────────────────────────────────────────────────────
# Used to protect /admin dashboard and CRM API
ADMIN_SECRET=change-me-strong-random-secret
# Optional: separate read-only secret for CFO dashboard access
CFO_SECRET=change-me-cfo-secret

# ── Paperclip (reply-to-task + inbound poller) ────────────────────────────────
PAPERCLIP_API_URL=http://host.docker.internal:3100
PAPERCLIP_API_KEY=
PAPERCLIP_COMPANY_ID=55be78fd-6837-49b8-a967-a03a72c43587
PAPERCLIP_GOAL_ID=fbd9599d-fd4d-4106-92a8-b85076f4b1e0
# Agent ID of the Chief of Sales — reply tasks will be assigned to them
CHIEF_OF_SALES_AGENT_ID=

# ── Telegram Bot (optional CEO notifications) ─────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# CEO agent issue ID (for budget/status pings)
CEO_ISSUE_ID=
BUDGET_ALERT_PCT=80
DAILY_SUMMARY_HOUR=8

# ── Resend Webhook (for open/click/bounce tracking) ───────────────────────────
# In Resend dashboard → Webhooks → add: https://demo.dlm-digital.ch/admin/api/webhook/resend
# Events to subscribe: email.sent, email.opened, email.clicked, email.bounced, email.complained
